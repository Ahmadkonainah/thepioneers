# Signs the persona cookie, witness links, and ruling records. Server-side only. At least 16 characters.
SESSION_SECRET=

# true: POST /api/session may switch Consultant / Finance / Expert. Anything else refuses the switch.
DEMO_MODE=true

# mock: deterministic local extractor, no network.
# gemini: POST https://generativelanguage.googleapis.com/v1beta/interactions
# A Gemini LlmError falls back to mock and the response says mock-fallback.
LLM_PROVIDER=mock

# Required when LLM_PROVIDER is gemini. Read only in lib/llm.ts on the server.
# Leave this empty. Put the real value in .env.local, which is gitignored.
GEMINI_API_KEY=

# Optional. Used only for Gemini. Default: gemini-3.8-flash.
LLM_MODEL=

# Optional. When unset, deposition falls back to typed answers. Server-side only.
ELEVENLABS_API_KEY=

# Optional public voice id. Defaults to a premade ElevenLabs voice.
ELEVENLABS_VOICE_ID=
