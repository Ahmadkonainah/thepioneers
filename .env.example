# Signs the persona cookie, witness links, and ruling records. Server-side only. At least 16 characters.
SESSION_SECRET=

# mock: deterministic local extractor, no network.
# openai: POST {LLM_BASE_URL}/v1/chat/completions
# anthropic: POST https://api.anthropic.com/v1/messages
LLM_PROVIDER=mock

# Required when LLM_PROVIDER is openai or anthropic. Never expose this to the client.
LLM_API_KEY=

# Optional. Defaults: gpt-4o-mini (openai), claude-3-5-haiku-latest (anthropic).
LLM_MODEL=

# Optional. OpenAI-compatible base URL. Ignored by mock and anthropic.
LLM_BASE_URL=https://api.openai.com

# Optional. When unset, deposition falls back to typed answers. Server-side only.
ELEVENLABS_API_KEY=

# Optional public voice id. Defaults to a premade ElevenLabs voice.
ELEVENLABS_VOICE_ID=
